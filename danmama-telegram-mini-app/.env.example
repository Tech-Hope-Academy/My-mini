# =============================================================================
# DANMAMA TELEGRAM MINI APP — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# Never commit a file that contains real secret values.
# =============================================================================

# --- Firebase Web App config (public — safe to expose to the browser) ------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Telegram Bot ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN is a secret: it is used server-side only and must
# never be prefixed with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# The bot's @username (without the @). This one IS public — it's only used
# to build the "Open in Telegram" link shown in the browser preview.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# The public URL of your deployed app (used to build the Mini App link and
# to set the Telegram webhook). Example: https://danmama.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional: secret path segment appended to the webhook URL for extra safety.
# Generate any random string, e.g. with `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

# --- Firebase Admin SDK (server-side only — NEVER expose to the browser) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
