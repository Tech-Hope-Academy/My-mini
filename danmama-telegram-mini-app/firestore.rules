rules_version = '2';

// -----------------------------------------------------------------------
// Danmama Firestore Security Rules
// -----------------------------------------------------------------------
// This app writes user profiles exclusively through the server-side
// Firebase Admin SDK (see lib/firebase-admin.ts + lib/user-store.ts),
// AFTER independently verifying the request's Telegram initData signature.
// The Admin SDK bypasses these rules entirely, which is exactly what we
// want: it is the only trusted writer.
//
// The rules below make sure that if anyone ever points the *client* SDK
// at this project, they cannot read or write anything. There is no
// Firebase Authentication session tied to Telegram users in this
// architecture, so "if false" is the correct, secure default — all data
// access must go through the validated API routes, never direct from the
// browser to Firestore.
// -----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
